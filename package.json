{
  "name": "trenchscope",
  "version": "1.0.0",
  "private": true,
  "description": "Birdeye-powered Solana token and wallet intelligence dashboard",
  "author": "driftmind-ai",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm --prefix api-server run dev\" \"npm --prefix frontend run dev -- --host 0.0.0.0 --port 3000 --strictPort\"",
    "dev:api": "npm --prefix api-server run dev",
    "dev:ui": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 3000 --strictPort",
    "build": "npm --prefix frontend run build",
    "test": "node --test api-server/dev-config.test.js api-server/server.test.js api-server/trenchscope-adapter.test.js && node --test frontend/src/components/trenchscope/radarUtils.test.mjs frontend/src/components/trenchscope/watchlistUtils.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
